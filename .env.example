TELEGRAM_TOKEN=
BOT_NAME=
SENTRY_DSN=
OPENAI_API_KEY=
OPENROUTER_KEY=
TOGETHER_API_KEY=
TOGETHER_TRANSCRIBE_MODEL=nvidia/parakeet-tdt-0.6b-v3
# Opt-in live transcription test (makes paid API requests).
RUN_TOGETHER_E2E=0
ADMIN_ID=
DEFAULT_MODEL=meta-llama/llama-3-70b-instruct
# Optional OpenRouter reasoning effort (e.g. low, medium, high); blank uses provider default.
REASONING_EFFORT=
# Output budget includes reasoning tokens; must fit the selected model limit.
MAX_OUTPUT_TOKENS=128000
MAX_MESSAGE_LENGTH=4096
